# The contact who should receive auto-replies.
# Country code + number, NO plus sign, NO spaces.
# Example for a German mobile +49 170 1234567 -> 491701234567
TARGET_NUMBER=491701234567

# Anthropic API key for generating varied replies.
# Get one at https://console.anthropic.com/  (this is separate from any Claude subscription)
ANTHROPIC_API_KEY=sk-ant-...

# How the bot should sound. Free text, edit to taste.
REPLY_PERSONA=Du bist mein freundlicher, leicht verschlafener Morgen-Buddy. Antworte herzlich und kurz auf Deutsch, mit maximal einem Emoji.

# Reply at most once per calendar day (true) or to every matching greeting (false).
ONCE_PER_DAY=true
