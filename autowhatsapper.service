[Unit]
Description=autowhatsapper - WhatsApp trigger-based auto-reply
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
# This unit is generic on purpose. Your host-specific settings — User,
# WorkingDirectory (where you copied the code), and optional WEB_HOST/WEB_PORT —
# live in a drop-in you own, so updating this file never overwrites them:
#   /etc/systemd/system/autowhatsapper.service.d/override.conf
# Copy override.conf.example there and fill it in (see DEPLOY.md). User and
# WorkingDirectory are required there — without them the service runs as root
# from / and can't find index.js.

[Install]
WantedBy=multi-user.target
